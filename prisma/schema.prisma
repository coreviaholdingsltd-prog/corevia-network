generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  phone              String?             @unique
  passwordHash       String
  referralCode       String              @unique
  referredById       String?
  membershipStatus   MembershipStatus    @default(PENDING)
  membershipPaidAt   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ledgerEntries      LedgerEntry[]
  membershipPayments MembershipPayment[]
  paymentRecords     PaymentRecord[]
  referralRewards    ReferralReward[]    @relation("RewardRecipient")
  generatedRewards   ReferralReward[]    @relation("RewardSource")
  spinEntries        SpinEntry[]
  referredBy         User?               @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]              @relation("UserReferrals")
  wallet             Wallet?
  transactions       WalletTransaction[]
  withdrawals        Withdrawal[]
  academyEnrollments AcademyEnrollment[]
  academyPayments    AcademyPayment[]
  postedGigs         Gig[]
  gigApplications    GigApplication[]
  memberProfile      MemberProfile?
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(14, 2)
  reference   String            @unique
  description String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MembershipPayment {
  id                String            @id @default(cuid())
  userId            String
  amount            Decimal           @db.Decimal(14, 2)
  provider          String
  providerReference String            @unique
  status            TransactionStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  verifiedAt        DateTime?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReferralReward {
  id             String   @id @default(cuid())
  recipientId    String
  sourceUserId   String
  level          Int
  amount         Decimal  @db.Decimal(14, 2)
  transactionRef String   @unique
  createdAt      DateTime @default(now())
  recipient      User     @relation("RewardRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sourceUser     User     @relation("RewardSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([sourceUserId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  ownerType   LedgerOwnerType
  userId      String?
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  reference   String          @unique
  description String?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ownerType, createdAt])
  @@index([userId, createdAt])
}

model PaymentRecord {
  id                  String             @id @default(cuid())
  userId              String
  amount              Decimal            @db.Decimal(14, 2)
  provider            String
  providerReference   String             @unique
  destination         PaymentDestination
  status              TransactionStatus  @default(PENDING)
  verifiedAt          DateTime?
  allocationReference String?            @unique
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Withdrawal {
  id               String           @id @default(cuid())
  userId           String
  amount           Decimal          @db.Decimal(14, 2)
  fee              Decimal          @db.Decimal(14, 2)
  netAmount        Decimal          @db.Decimal(14, 2)
  status           WithdrawalStatus @default(PENDING)
  reference        String           @unique
  paymentReference String?
  createdAt        DateTime         @default(now())
  processedAt      DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SpinEvent {
  id              String      @id @default(cuid())
  scheduledFor    DateTime
  status          SpinStatus  @default(SCHEDULED)
  totalAllocation Decimal     @db.Decimal(14, 2)
  maxWin          Decimal     @db.Decimal(14, 2)
  createdAt       DateTime    @default(now())
  completedAt     DateTime?
  entries         SpinEntry[]

  @@index([scheduledFor])
}

model SpinEntry {
  id          String    @id @default(cuid())
  spinEventId String
  userId      String
  amountWon   Decimal   @default(0) @db.Decimal(14, 2)
  isWinner    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  spinEvent   SpinEvent @relation(fields: [spinEventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spinEventId, userId])
  @@index([userId])
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  location    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  MEMBERSHIP_PAYMENT
  REFERRAL_REWARD
  SPIN_REWARD
  WITHDRAWAL
  WITHDRAWAL_FEE
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
}

enum SpinStatus {
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum LedgerOwnerType {
  COREVIA
  MEMBER
}

enum PaymentDestination {
  COREVIA_TILL
  OTHER
}


enum AcademyEnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
}

model AcademyEnrollment {
  id             String                  @id @default(cuid())
  userId         String
  courseId       String
  status         AcademyEnrollmentStatus @default(PENDING_PAYMENT)
  amountPaid     Decimal                 @default(0) @db.Decimal(14, 2)
  enrolledAt     DateTime                @default(now())
  completedAt    DateTime?
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonProgress AcademyLessonProgress[]
  attempts       AcademyAssessmentAttempt[]
  completion     AcademyCompletion?
  payments       AcademyPayment[]

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
}

model AcademyLessonProgress {
  id           String            @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime          @default(now())
  enrollment   AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model AcademyAssessmentAttempt {
  id             String            @id @default(cuid())
  enrollmentId   String
  score          Int
  totalQuestions Int
  passed         Boolean
  createdAt      DateTime          @default(now())
  enrollment     AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
}

model AcademyCompletion {
  id              String            @id @default(cuid())
  enrollmentId    String            @unique
  certificateCode String            @unique
  issuedAt        DateTime          @default(now())
  enrollment      AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model AcademyPayment {
  id                String            @id @default(cuid())
  userId            String
  enrollmentId      String
  courseId          String
  amount            Decimal           @db.Decimal(14, 2)
  provider          String
  providerReference String            @unique
  status            TransactionStatus @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment        AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([enrollmentId, status])
}


// Corevia Rise Gigs: work listings and applications.
enum GigStatus {
  PENDING_REVIEW
  OPEN
  PAUSED
  CLOSED
  REJECTED
}

enum GigWorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum GigBudgetType {
  FIXED
  HOURLY
  NEGOTIABLE
}

enum GigApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  DECLINED
}

model Gig {
  id          String      @id @default(cuid())
  ownerId     String
  title       String
  description String
  category    String
  location    String?
  workMode    GigWorkMode @default(REMOTE)
  budgetKsh   Int?
  budgetType  GigBudgetType @default(NEGOTIABLE)
  deadline    DateTime?
  status      GigStatus   @default(PENDING_REVIEW)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications GigApplication[]

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@index([category, status])
}

model GigApplication {
  id          String                @id @default(cuid())
  gigId       String
  applicantId String
  proposal    String
  portfolioUrl String?
  status      GigApplicationStatus  @default(SUBMITTED)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  gig         Gig                   @relation(fields: [gigId], references: [id], onDelete: Cascade)
  applicant   User                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([gigId, applicantId])
  @@index([applicantId, createdAt])
  @@index([gigId, status])
}

// Corevia Network member profiles and public work samples.
model MemberProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  headline    String          @default("")
  bio         String          @default("")
  location    String?
  skills      String          @default("")
  websiteUrl  String?
  linkedinUrl String?
  githubUrl   String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PortfolioItem[]

  @@index([isPublic, updatedAt])
}

model PortfolioItem {
  id          String        @id @default(cuid())
  profileId   String
  title       String
  category    String?
  description String
  projectUrl  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}
